CLAUDE_API_KEY=set-in-host-environment
CLAUDE_MODEL=claude-sonnet-4-6
QUIZ_STATE_SECRET=set-a-unique-random-value-at-least-32-chars
PORT=3001
HOST=0.0.0.0
# true means one reverse-proxy hop, not trust-every-proxy
TRUST_PROXY=true
# Comma-separated exact http(s) origins. * is ignored. Same-origin requests are allowed without this.
# ALLOWED_ORIGINS=https://your-host.example
