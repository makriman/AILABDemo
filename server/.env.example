CLAUDE_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6
QUIZ_STATE_SECRET=replace-with-a-long-random-secret
# Leave unset to keep POST /api/quiz/generate from calling Claude.
# Set a random string of at least 16 characters and send it as X-Quiz-Generation-Secret.
# Do not commit a real value. VITE_QUIZ_GENERATION_SECRET embeds the secret in the public client.
QUIZ_GENERATION_SECRET=
PORT=3001
HOST=0.0.0.0
TRUST_PROXY=true
